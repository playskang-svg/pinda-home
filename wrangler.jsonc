{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "pinda-home",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "next.pinda.kr", "custom_domain": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "446f94ef-2b64-4fa6-b6e0-f554791dd2e9",
      "database_name": "pinda-home",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "pinda-home-media", "remote": true }]
}
